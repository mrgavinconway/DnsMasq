[Unit]
Description=Lightweight dnsmasq web interface
After=network.target dnsmasq.service
Requires=dnsmasq.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dnsmasq-web
ExecStart=/usr/bin/python3 -u /opt/dnsmasq-web/app.py --host 0.0.0.0 --port 80
EnvironmentFile=-/etc/default/dnsmasq-web
Restart=on-failure
RestartSec=3
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RuntimeDirectory=dnsmasq-web
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
# Atomic replacement creates a temporary sibling before renaming it over the
# target, so the containing directory must be writable inside the sandbox.
ReadWritePaths=/etc

[Install]
WantedBy=multi-user.target
